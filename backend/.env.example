# NEXUS backend configuration — copy to `.env` and adjust.
# Every variable uses the NEXUS_ prefix.

# Network binding for the API server.
# 127.0.0.1 = this computer only (safe default when running uvicorn manually).
# 0.0.0.0   = reachable from phones/tablets on the same Wi-Fi (demo mode).
# start.sh binds 0.0.0.0 unless you override NEXUS_HOST.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000

# Comma-separated browser origins allowed to call the API (explicit
# allowlist — never "*").
# For phone access, add your LAN origin, e.g.:
#   NEXUS_CORS_ORIGINS=http://localhost:3000,http://192.168.1.42:3000
# start.sh detects the LAN IP and sets this automatically when unset.
NEXUS_CORS_ORIGINS=http://localhost:3000

# SQLite database location (relative to backend/ or absolute path).
NEXUS_DATABASE_URL=nexus.db
