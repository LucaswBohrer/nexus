# NEXUS frontend configuration — copy to `.env.local` if you need it.
#
# Optional. Explicit API base URL for the dashboard (no trailing slash).
#
# When UNSET (recommended for demos), the dashboard calls the API on the
# same host that serves the page, port 8000. That means opening
# http://<your-pc-ip>:3000 on your phone automatically talks to
# http://<your-pc-ip>:8000 — no rebuild needed.
#
# Set it only to override that behavior (different host or port), e.g.:
# NEXT_PUBLIC_API_URL=http://192.168.1.42:8000
#
# NOTE: NEXT_PUBLIC_* variables are baked in at build time. For `next dev`
# they are read when the dev server starts.
NEXT_PUBLIC_API_URL=
